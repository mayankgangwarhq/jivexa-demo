# ==============================================================================
# JIVEXA HEALTH OS - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Core Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Primary Database Configuration: MongoDB
# Accepts either MONGO_URI or MONGO_URL (trimmed).
# For local development:
# MONGO_URI=mongodb://127.0.0.1:27017/jivexa_auth
# For MongoDB Atlas:
# Ensure IP address is allowlisted in Atlas Network Access and special characters in password are URL-encoded.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jivexa?retryWrites=true&w=majority
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jivexa?retryWrites=true&w=majority

# JWT Authentication Secret (REQUIRED)
# Server validates JWT_SECRET at startup. Must be a secure random string.
JWT_SECRET=<your-strong-jwt-secret-key-min-32-chars>

# AI Engine Configurations (Google Gemini) - Two Independent API Configurations
# Obtain API keys from Google AI Studio (https://aistudio.google.com/)

# 1. Existing General Health Chatbot (Chatbot A)
GEMINI_CHATBOT_API_KEY=your_private_chatbot_key
GEMINI_CHATBOT_MODEL=gemini-3.5-flash-lite

# 2. Medical Report Analyzer & Report Assistant Chatbot (Chatbot B)
GEMINI_REPORT_API_KEY=your_private_report_key
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite

# Universal Fallback Key (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Email / SMTP Dispatch Configuration
# When unconfigured, verification links are printed directly to the server console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-smtp-email>
SMTP_PASS=<your-smtp-app-password>
SMTP_FROM="JIVEXA Health" <support@jivexa.com>

# Authentication Feature Flags
# Set OTP_ENABLED=false for Patient MVP (patients are automatically verified and active)
OTP_ENABLED=false

# Patient-First MVP Launch Mode
# When true, restricts ecosystem surface to Patient module workflows
PATIENT_MVP_ONLY=true
