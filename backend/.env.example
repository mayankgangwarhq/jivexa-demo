# ==============================================================================
# JIVEXA HEALTH OS - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Core Server Configuration
PORT=4000
NODE_ENV=development
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173

# Primary Database Configuration: MongoDB
# Accepts either MONGO_URI or MONGO_URL (trimmed).
# For local development:
# MONGO_URI=mongodb://127.0.0.1:27017/jivexa_auth
# MONGO_URL=mongodb://127.0.0.1:27017/jivexa_auth
# For MongoDB Atlas:
# Ensure IP address is allowlisted in Atlas Network Access and special characters in password are URL-encoded.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jivexa?retryWrites=true&w=majority
# MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jivexa?retryWrites=true&w=majority

# JWT Authentication Secret (REQUIRED)
# Server will fail fast and exit at startup if JWT_SECRET is missing.
# Must be a secure, random string (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=<your-strong-jwt-secret-key-min-32-chars>

# Authentication Feature Flags
# Set OTP_ENABLED=false for Patient MVP (patients are automatically verified and active)
# Re-enable OTP by setting OTP_ENABLED=true
OTP_ENABLED=false

# Patient-First MVP Launch Mode
# When true, restricts ecosystem surface to Patient module workflows
PATIENT_MVP_ONLY=true

# AI Engine Configuration (Google Gemini) - Optional for Auth module
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash
