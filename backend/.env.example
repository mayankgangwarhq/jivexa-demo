# ==============================================================================
# JIVEXA HEALTH OS - BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# Core Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Primary Database: MongoDB Atlas (Mongoose)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jivexa?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jivexa?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random secret)
JWT_SECRET=<your-jwt-secret-key>

# AI Engine Configurations (Google Gemini) - Two Independent API Configurations
# Obtain API keys from Google AI Studio (https://aistudio.google.com/)

# 1. Existing General Health Chatbot (Chatbot A)
GEMINI_CHATBOT_API_KEY=your_private_chatbot_key
GEMINI_CHATBOT_MODEL=gemini-3.5-flash-lite

# 2. Medical Report Analyzer & Report Assistant Chatbot (Chatbot B)
GEMINI_REPORT_API_KEY=your_private_report_key
GEMINI_REPORT_MODEL=gemini-3.5-flash-lite

# Legacy Fallback Variable (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Email / SMTP Dispatch Configuration
# When unconfigured, verification links are printed directly to the server console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-smtp-email>
SMTP_PASS=<your-smtp-app-password>
SMTP_FROM="JIVEXA Health" <support@jivexa.com>

# Authentication Feature Flags
# Set OTP_ENABLED=true to enable mandatory email OTP verification for logins/signups
OTP_ENABLED=false

# Patient-First MVP Launch Mode
PATIENT_MVP_ONLY=true
